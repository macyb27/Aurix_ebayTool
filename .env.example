# AURIX Backend - Umgebungsvariablen
# Kopiere zu .env und passe an

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aurix

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# eBay API (Developer Account erforderlich)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_SANDBOX=true

# OpenAI (für Vision/Bildanalyse)
OPENAI_API_KEY=
