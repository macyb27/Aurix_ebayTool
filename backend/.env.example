# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aurix
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/aurix

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# eBay API (Sandbox)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_SANDBOX=true

# AI (optional)
AI_API_KEY=
AI_BASE_URL=
